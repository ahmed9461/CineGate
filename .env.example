# Secrets / sensitive bootstrap values only.
# Copy to .env locally and never commit the real values.

CINEGATE_BOT_TOKEN=123456789:replace-with-real-token
CINEGATE_DATABASE_URL=postgresql+asyncpg://cinegate:replace-password@127.0.0.1:5432/cinegate
CINEGATE_WEBHOOK_SECRET=replace-with-random-secret
CINEGATE_POSTGRES_PASSWORD=replace-password
