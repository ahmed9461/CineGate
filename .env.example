# Secrets / sensitive bootstrap values only.
# Copy to .env locally and never commit the real values.

CINEGATE_BOT_TOKEN=123456789:replace-with-real-token
CINEGATE_DATABASE_URL=postgresql+asyncpg://cinegate:replace-password@127.0.0.1:5432/cinegate
CINEGATE_WEBHOOK_SECRET=replace-with-random-secret
CINEGATE_POSTGRES_PASSWORD=replace-password

# Optional until AdsGram Reward URL is enabled.
# Generate a URL-safe random value of at least 32 characters.
# CINEGATE_ADSGRAM_CALLBACK_SECRET=<generated-random-value>

# Owner-only admin bootstrap identity.
# CINEGATE_OWNER_USER_ID=123456789


# One-time historical UserBot importer only.
# Obtain these from Telegram API Development tools.
# CINEGATE_TELEGRAM_API_ID=123456
# CINEGATE_TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
